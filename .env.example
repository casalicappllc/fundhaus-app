# Copy these two values from Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# For deals that fill themselves in from the application + bank statements (server only, never NEXT_PUBLIC_).
# Create at console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=

# DataMerch check (server only). DataMerch -> API credentials.
DATAMERCH_AUTH_TOKEN=
DATAMERCH_AUTH_KEY=

# Sending deals to lenders (server only). The mailbox lenders receive submissions from.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SUBMIT_FROM=
